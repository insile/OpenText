filters:
  and:
    - file.folder.startsWith("文档/人文社科/英语/英语单词/words")
    - file.tags.contains("级别/GRE")
views:
  - type: table
    name: GRE
    order:
      - 掌握
      - file.name
      - 易记因子
      - 重复次数
      - 间隔
      - 到期日
