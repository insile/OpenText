
filters:
  and:
    - file.folder.startsWith("笔记/人文社科/英语/英语单词/words")
    - file.tags.contains("级别/小学")
views:
  - type: table
    name: 小学
    order:
      - 掌握
      - file.name
      - 易记因子
      - 重复次数
      - 间隔
      - 到期日
