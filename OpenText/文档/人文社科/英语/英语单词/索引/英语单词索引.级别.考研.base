filters:
  and:
    - file.folder.startsWith("文档/人文社科/英语/英语单词/words")
    - file.tags.contains("级别/考研")
views:
  - type: table
    name: 考研
    order:
      - 掌握
      - file.name
      - 易记因子
      - 重复次数
      - 间隔
      - 到期日
  - type: table
    name: 考研.A
    filters:
      and:
        - file.basename.startsWith("a")
    order:
      - 掌握
      - file.name
