filters:
  and:
    - file.folder.startsWith("文档/人文社科/英语/英语单词/words")
views:
  - type: table
    name: 总计
    order:
      - 掌握
      - file.name
      - 易记因子
      - 重复次数
      - 间隔
      - 到期日
  - type: table
    name: 待学习
    filters:
      and:
        - or:
            - file.tags.contains("级别/小学")
            - file.tags.contains("级别/中考")
            - file.tags.contains("级别/高考四级")
            - file.tags.contains("级别/考研")
            - file.tags.contains("级别/六级")
            - file.tags.contains("级别/雅思")
            - file.tags.contains("级别/托福")
            - file.tags.contains("级别/GRE")
        - and:
            - 掌握 == false
        - and:
            - 重复次数 == 0
    order:
      - 掌握
      - file.name
      - 易记因子
      - 重复次数
      - 间隔
      - 到期日
  - type: table
    name: 待复习
    filters:
      and:
        - or:
            - file.tags.contains("级别/小学")
            - file.tags.contains("级别/中考")
            - file.tags.contains("级别/高考四级")
            - file.tags.contains("级别/考研")
            - file.tags.contains("级别/六级")
            - file.tags.contains("级别/雅思")
            - file.tags.contains("级别/托福")
            - file.tags.contains("级别/GRE")
        - and:
            - 掌握 == false
        - and:
            - 重复次数 != 0
        - and:
            - 到期日 > today()
    order:
      - 掌握
      - file.name
      - 易记因子
      - 重复次数
      - 间隔
      - 到期日
  - type: table
    name: 今日到期
    filters:
      and:
        - or:
            - file.tags.contains("级别/小学")
            - file.tags.contains("级别/中考")
            - file.tags.contains("级别/高考四级")
            - file.tags.contains("级别/考研")
            - file.tags.contains("级别/六级")
            - file.tags.contains("级别/雅思")
            - file.tags.contains("级别/托福")
            - file.tags.contains("级别/GRE")
        - and:
            - 掌握 == false
        - and:
            - 重复次数 != 0
        - and:
            - 到期日 <= today()
    order:
      - 掌握
      - file.name
      - 易记因子
      - 重复次数
      - 间隔
      - 到期日
  - type: table
    name: 已掌握
    filters:
      and:
        - and:
            - 掌握 == true
    order:
      - 掌握
      - file.name
      - 易记因子
      - 重复次数
      - 间隔
      - 到期日
  - type: table
    name: 未启用
    filters:
      or:
        - not:
            - file.tags.contains("级别/小学")
            - file.tags.contains("级别/中考")
            - file.tags.contains("级别/高考四级")
            - file.tags.contains("级别/考研")
            - file.tags.contains("级别/六级")
            - file.tags.contains("级别/雅思")
            - file.tags.contains("级别/托福")
            - file.tags.contains("级别/GRE")
        - and:
            - 掌握 == true
    order:
      - 掌握
      - file.name
      - 易记因子
      - 重复次数
      - 间隔
      - 到期日
